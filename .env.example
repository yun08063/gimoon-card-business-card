# 예제 파일입니다. 실제 키는 .env에 입력하세요. Docker는 이 파일을 읽지 않습니다.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
POSTGRES_DB=artist
POSTGRES_USER=artist
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_HOST=db

# Spotify Web API (optional; blank values show credentials_required)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Last.fm album metadata API (optional)
LASTFM_API_KEY=

# SoundCloud public API (optional; register an app to get credentials)
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# TIDAL catalog API (optional; developer portal app credentials)
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=
TIDAL_COUNTRY_CODE=US

# Providers completely disabled, including source URL lookup
DISABLED_PROVIDERS=spotify

# Providers omitted when searching for matching albums from other catalogs
SEARCH_EXCLUDED_PROVIDERS=apple,deezer,tidal,amazon,soundcloud

# Google OAuth (Google Cloud Console Web application credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback/
